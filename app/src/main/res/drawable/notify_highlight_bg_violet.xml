<?xml version="1.0" encoding="utf-8"?>
<!-- 보라 쪽으로 더 기울인 하이라이트 배경 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#241C63"
        android:centerColor="#3A1F72"
        android:endColor="#5B1F6B"
        android:centerX="0.5"
        android:centerY="0.5" />
    <stroke
        android:width="1dp"
        android:color="#8B6CFF" />
</shape>