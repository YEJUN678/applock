<?xml version="1.0" encoding="utf-8"?>
<!--
  접힌 상태용 얇은 배경.
  둥근 모서리가 크면 64dp 높이 안에서 내용이 잘려 보인다.
  카드와 같은 색이지만 테두리만 옅게 준다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#1B2A6B"
        android:centerColor="#2B2170"
        android:endColor="#3A1F6B" />
</shape>