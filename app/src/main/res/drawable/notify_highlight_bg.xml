<?xml version="1.0" encoding="utf-8"?>
<!-- 알림 하이라이트용 배경. 파랑 -> 보라를 은은하게 섞는다. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#1B2A6B"
        android:centerColor="#2B2170"
        android:endColor="#3A1F6B"
        android:centerX="0.45"
        android:centerY="0.6" />
    <stroke
        android:width="1dp"
        android:color="#4D7CFF" />
</shape>