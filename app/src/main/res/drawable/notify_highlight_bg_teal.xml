<?xml version="1.0" encoding="utf-8"?>
<!-- 청록 쪽 하이라이트 배경 (은은한 파랑 계열 유지) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#123A5B"
        android:centerColor="#173C63"
        android:endColor="#1E2F6B"
        android:centerX="0.5"
        android:centerY="0.5" />
    <stroke
        android:width="1dp"
        android:color="#3AA8FF" />
</shape>